# RestoPilot environment configuration
# Copy this file to `.env` and fill in real values. `.env` is git-ignored —
# never commit real values (spec FR-006). See docs/development.md → Setup.

# --- Public frontend credentials (safe to embed in the client) ---

# Supabase Cloud project URL.
# Source: Supabase Dashboard → Project Settings → API → Project URL
# Example: https://<project-ref>.supabase.co
VITE_SUPABASE_URL=

# Supabase anonymous (public) key — public by design, protected by RLS.
# Source: Supabase Dashboard → Project Settings → API keys → anon/public key
VITE_SUPABASE_ANON_KEY=

# --- Secret values (scripts and database tests ONLY — never in frontend code) ---

# Direct PostgreSQL connection string for the cloud development database.
# Source: Supabase Dashboard → Project Settings → Database → Connection string (URI)
SUPABASE_DB_URL=

# --- Supabase CLI convenience ---

# Project reference used by `supabase link` and helper commands.
# Source: Supabase Dashboard → Project Settings → General → Reference ID
SUPABASE_PROJECT_REF=
