# RestoPilot environment configuration
# Copy this file to `.env` and fill in real values. `.env` is git-ignored —
# never commit real values (spec FR-006). See docs/development.md → Setup.

# --- Public frontend credentials (safe to embed in the client) ---

# Supabase Cloud project URL.
# Source: Supabase Dashboard → Connect (or Project Settings → API)
# Example: https://<project-ref>.supabase.co
VITE_SUPABASE_URL=

# Supabase publishable key (starts with sb_publishable_) — public by design,
# protected by Row Level Security. Legacy anon JWT keys are deprecated by
# Supabase (end of 2026); use the publishable key for client-side code.
# Source: Supabase Dashboard → Project Settings → API keys (or Connect)
VITE_SUPABASE_PUBLISHABLE_KEY=

# --- Secret values (scripts and database tests ONLY — never in frontend code) ---

# Direct PostgreSQL connection string for the cloud development database.
# Source: Supabase Dashboard → Connect → Session pooler (URI).
# Prefer the session pooler (port 5432) — it works on IPv4-only networks.
# Percent-encode special characters in the password.
SUPABASE_DB_URL=

# --- Supabase CLI convenience ---

# Project reference used by `supabase link` and helper commands.
# Source: Supabase Dashboard → Project Settings → General → Reference ID
SUPABASE_PROJECT_REF=
