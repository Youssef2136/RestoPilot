# eslint-plugin-jsx-a11y@6.10.2 declares peer eslint "^3..^9" but fully
# supports flat config and ESLint 10 (verified by `npm run lint`); the
# legacy resolution is required since ESLint 10 postdates the plugin's peer
# metadata. Recorded in specs/021-frontend-foundation (FR-06 tooling note).
legacy-peer-deps=true
